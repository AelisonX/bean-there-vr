# Render environment settings. Never put provider secrets in VITE_* variables.
HOST=0.0.0.0
ALLOWED_ORIGINS=https://aelisonx.github.io,https://bean-there-vr.onrender.com
# Add the exact itch.io iframe Origin after creating the draft upload and inspecting it.
# Cloudflare Realtime TURN key ID and its associated API token:
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Alternatively use your own TURN server (leave Cloudflare settings empty):
# TURN_URLS=turn:your-relay:3478?transport=udp,turns:your-relay:443?transport=tcp
# TURN_SECRET=your-coturn-shared-secret
